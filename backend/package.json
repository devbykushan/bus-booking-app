{
  "name": "omnibus-backend",
  "version": "1.0.0",
  "description": "OmniBus REST API — Express + SQLite backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "./node_modules/.bin/ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:backend": "./node_modules/.bin/ts-node-dev --respawn --transpile-only src/index.ts",
    "db:migrate": "./node_modules/.bin/ts-node-dev --transpile-only src/db/migrate.ts",
    "build": "./node_modules/.bin/tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
